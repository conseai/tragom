# Copy this file to .env (which is ignored by git):  cp .env.example .env
# These values are for local development only. Never put real production secrets here.

DB_NAME=travel
DB_USER=travel
DB_PASSWORD=changeme

# Host ports. Change one if it is already in use on your machine.
DB_PORT=5432
API_PORT=8080
WEB_PORT=4200

# Optional pgAdmin (docker compose --profile tools up -d pgadmin)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
